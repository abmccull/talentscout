# No environment values are required for local offline gameplay.
# Copy to .env.local only when configuring an optional service.
# NEXT_PUBLIC_* values are compiled into browser/desktop JavaScript, not secrets.

# Optional cloud-account configuration; leave both blank for local-only play.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fail-closed. Enable only after production feedback RLS, abuse throttling,
# retention, and monitoring have been certified for this exact build.
NEXT_PUBLIC_ENABLE_ONLINE_FEEDBACK=false

# Optional locally; required for signed release packaging. Use the public client DSN.
# Reports retain error type, compiled stack locations, build SHA, and a renderer tag.
# Raw messages, user/request data, breadcrumbs, and save contents are omitted.
NEXT_PUBLIC_SENTRY_DSN=

# Youth Scout is the supported Early Access scope. Keep future modes disabled.
NEXT_PUBLIC_YOUTH_EARLY_ACCESS=true
# Optional two-season demo limit; false enables the normal Youth Scout career.
NEXT_PUBLIC_DEMO=false

# Asset-generation scripts only; never expose this as NEXT_PUBLIC or commit a value.
ELEVENLABS_API_KEY=

# NEXT_PUBLIC_BUILD_VERSION and NEXT_PUBLIC_APP_VERSION are set by the build wrapper.
# Do not override the build SHA with a label or a different commit.
