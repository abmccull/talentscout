  "cases": [
    {
      "id": "VS01",
      "purpose": "mismatched-language-must-not-reuse-en-on-503",
      "shared": true,
      "firstRequest": {
        "accept-language": "en"
      },
      "first": {
        "status": 200,
        "body": "A",
        "headers": {
          "cache-control": "public, max-age=0, stale-if-error=300",
          "age": "120",
          "etag": "\"A\"",
          "vary": "accept-language"
        }
      },
      "secondOrigin": {
        "status": 503,
        "body": "origin-unavailable",
        "headers": {
          "cache-control": "no-store"
        }
      },
      "directives": {
        "public": true,
        "max-age": "0",
        "stale-if-error": "300"
      },
      "secondRequest": {
        "accept-language": "fr"
      },
      "secondValidators": {
        "if-none-match": null,
        "if-modified-since": null
      },
      "expect": {
        "base": "stale-if-error-A",
        "candidate": "http-error-503"
      },
      "requiredReproduction": true
    },
    {
      "id": "VS02",
